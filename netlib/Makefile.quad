# Makefile for Windows using gfortran to build QUADPACK library

FORTRAN = gfortran
# Use legacy Fortran features and fixed format
FFLAGS = -c -std=legacy -ffixed-form -fno-sign-zero -w
LIB = ar
LIBFLAGS = rcs

QUAD_DIR = quad
LIB_NAME = libquad.a

all: $(LIB_NAME)

# Build the library by compiling all .f files and then creating the library
$(LIB_NAME):
	@echo Compiling all Fortran files in $(QUAD_DIR) directory...
	@for %%f in ($(QUAD_DIR)\*.f) do $(FORTRAN) $(FFLAGS) -o $(QUAD_DIR)\%%~nf.o %%f
	@echo Creating library $(LIB_NAME)...
	$(LIB) $(LIBFLAGS) $(LIB_NAME) $(QUAD_DIR)\*.o

# Inference rule for nmake to compile .f files to .o files in the quad directory
{$(QUAD_DIR)}.f{$(QUAD_DIR)}.o:
	$(FORTRAN) $(FFLAGS) -o $@ $<

clean:
	@if exist $(QUAD_DIR)\*.o del $(QUAD_DIR)\*.o
	@if exist $(QUAD_DIR)\*.obj del $(QUAD_DIR)\*.obj
	@if exist $(LIB_NAME) del $(LIB_NAME)
	@if exist *.mod del *.mod